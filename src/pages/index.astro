---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section style="max-width: 900px; margin: 3rem auto; padding: 0 1rem;">
				<div style="display: grid; gap: 1.5rem;">
					<div style="padding: 2rem; border-radius: 24px; background: rgba(255, 248, 240, 0.9); box-shadow: var(--box-shadow);">
						<p style="margin: 0 0 0.5rem; color: rgb(var(--accent)); text-transform: uppercase; letter-spacing: 0.2em; font-size: 0.85rem;">Newborn Care Blog</p>
						<h1 style="margin: 0 0 1rem; font-size: clamp(2.5rem, 4vw, 4rem); line-height: 1.05;">Trusted guidance for new parents, one gentle step at a time.</h1>
						<p style="margin: 0; font-size: 1.1rem; line-height: 1.8; color: rgb(var(--gray-dark));">
							Practical articles on newborn health, safe clothing, essential accessories, and daily care routines that help babies thrive and parents feel confident.
						</p>
					</div>

					<div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));">
						<div style="padding: 1.5rem; border-radius: 16px; background: rgb(var(--surface)); box-shadow: var(--box-shadow);">
							<h2 style="margin-top: 0;">Health & Wellness</h2>
							<p style="margin: 0; color: rgb(var(--gray-dark));">
								Evidence-based newborn care advice, feeding support, safe sleep tips, and nurturing routines for the first months.
							</p>
						</div>
						<div style="padding: 1.5rem; border-radius: 16px; background: rgb(var(--surface)); box-shadow: var(--box-shadow);">
							<h2 style="margin-top: 0;">Clothing & Comfort</h2>
							<p style="margin: 0; color: rgb(var(--gray-dark));">
								Guides for choosing gentle fabrics, layering for changing weather, and building a newborn wardrobe that is safe, soft, and easy to use.
							</p>
						</div>
						<div style="padding: 1.5rem; border-radius: 16px; background: rgb(var(--surface)); box-shadow: var(--box-shadow);">
							<h2 style="margin-top: 0;">Baby Gear & Accessories</h2>
							<p style="margin: 0; color: rgb(var(--gray-dark));">
								Honest reviews and recommendations for newborn essentials like carriers, swaddles, monitors, and bath-time helpers.
							</p>
						</div>
					</div>

					<div style="padding: 1.75rem; border-radius: 20px; background: rgba(234, 248, 254, 0.9); box-shadow: var(--box-shadow);">
						<h2 style="margin-top: 0;">What to expect here</h2>
						<ul style="margin: 1rem 0 0 1rem; padding: 0; color: rgb(var(--gray-dark));">
							<li style="margin: 0.5rem 0;">Actionable newborn health tips backed by pediatric care best practices.</li>
							<li style="margin: 0.5rem 0;">Simple clothing advice for sensitive skin and easy dressing.</li>
							<li style="margin: 0.5rem 0;">Accessory guides for safety, comfort, and everyday convenience.</li>
							<li style="margin: 0.5rem 0;">Friendly support for new parents, focused on confidence and realistic expectations.</li>
						</ul>
					</div>

					<div style="padding: 2rem; border-radius: 20px; background: rgb(var(--surface)); box-shadow: var(--box-shadow);">
						<h2 style="margin-top: 0;">Start reading</h2>
						<p style="margin: 0 0 1rem; color: rgb(var(--gray-dark));">
							Visit the blog and explore the latest newborn care stories.
						</p>
						<a href="/blog/" style="display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.9rem 1.4rem; border-radius: 999px; background: rgb(var(--accent)); color: white; text-decoration: none; font-weight: 600;">Explore Blog</a>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>
