---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, category, tags } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			body {
				margin: 0;
				min-height: 100vh;
				background: radial-gradient(circle at top, rgba(255, 249, 240, 0.9), rgba(255, 244, 236, 1) 40%, white 100%);
				color: rgb(var(--gray-dark));
			}
			main {
				width: min(100%, 1080px);
				margin: 0 auto;
				padding: 2rem 1rem 3rem;
			}
			article {
				background: white;
				border-radius: 32px;
				box-shadow: var(--box-shadow);
				overflow: hidden;
			}
			.hero-image {
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
			}
			.hero-image img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			.header-block {
				padding: 2rem 2rem 1.5rem;
				background: rgba(250, 244, 239, 0.95);
			}
			.label {
				display: inline-flex;
				padding: 0.45rem 0.9rem;
				border-radius: 999px;
				background: rgb(var(--accent));
				color: white;
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 0.06em;
				text-transform: uppercase;
			}
			.category {
				margin: 0.5rem 0 0.35rem;
				color: rgb(var(--accent));
				font-size: 0.95rem;
				font-weight: 700;
			}
			.tags {
				margin: 0.75rem 0 0;
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
			}
			.tag {
				padding: 0.35rem 0.85rem;
				border-radius: 999px;
				background: rgba(255, 237, 230, 0.9);
				font-size: 0.88rem;
				color: rgb(var(--gray-dark));
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				gap: 0.75rem;
				margin: 1rem 0 1.5rem;
				color: rgb(var(--gray));
				font-size: 0.95rem;
			}
			.title-section {
				margin: 0;
			}
			.title-section h1 {
				margin: 0;
				font-size: clamp(2rem, 4vw, 3.4rem);
				line-height: 1.05;
				color: rgb(var(--black));
			}
			.subtitle {
				margin: 1rem 0 0;
				font-size: 1.1rem;
				line-height: 1.8;
				color: rgb(var(--gray-dark));
			}
			.separator {
				margin: 2rem 0 0;
				border: 0;
				height: 1px;
				background: rgba(0, 0, 0, 0.08);
			}
			.content {
				padding: 2rem;
				line-height: 1.85;
				font-size: 1rem;
			}
			.content img {
				max-width: 100%;
				height: auto;
				border-radius: 16px;
			}
			.content h2,
			.content h3 {
				color: rgb(var(--black));
			}
			.content blockquote {
				margin: 1.75rem 0;
				padding: 1.25rem 1.5rem;
				border-left: 4px solid rgb(var(--accent));
				background: rgba(255, 249, 240, 0.9);
			}
			@media (max-width: 720px) {
				main {
					padding: 1.5rem 1rem 2rem;
				}
				.header-block {
					padding: 1.5rem 1.25rem 1rem;
				}
				.content {
					padding: 1.5rem 1rem 2rem;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				{heroImage && (
					<div class="hero-image">
						<Image width={1200} height={675} src={heroImage} alt={title} />
					</div>
				)}
				<div class="header-block">
					<span class="label">Newborn Care Guide</span>
					{category && <span class="category">{category}</span>}
					{tags && (
						<div class="tags">
							{tags.map((tag) => (
								<span class="tag">{tag}</span>
							))}
						</div>
					)}
					<div class="meta">
						<span>{pubDate && <FormattedDate date={pubDate} />}</span>
						{updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
					</div>
					<div class="title-section">
						<h1>{title}</h1>
						<p class="subtitle">{description}</p>
					</div>
					<hr class="separator" />
				</div>
				<div class="content">
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
